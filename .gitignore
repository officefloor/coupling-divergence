# Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# Vendored dependencies, fetched by setup.sh into a known location (never committed).
/lib/

# All experiment output is data, not method: regenerated by running the experiment.
# Published data goes in the paper's ancillary content, not the repository.
/results/

# Raw history mines (large; written under results/ by default, but guard loose ones too).
*.methods.jsonl
*.commits.jsonl

# Paper tables are generated from results/ by paper/make_tables.py (./step3_analyse.sh).
/paper/tables.md
/paper/aggregate.tex
